# O menu cria .env com senhas aleatorias ao usar uma opcao de gerenciamento.
# Configure antes de criar o volume. Alterar senhas aqui nao altera um banco existente.
MYSQL_ROOT_PASSWORD=troque_esta_senha_root
DB_NAME=alocacao
DB_USER=alocacao
DB_PASSWORD=troque_esta_senha
MYSQL_PORT=3308
PHPMYADMIN_PORT=8081

# Interface visual do algoritmo (acesso local por padrao).
WEB_HOST=127.0.0.1
WEB_PORT=8000
